# =============================================
# FastenerModel AI — 本地环境配置示例
# =============================================
# 复制此文件为 .env.local 并填入实际值
# cp .env.example .env.local

# =============================================
# 大语言模型服务配置
# =============================================

# ── 自建 API（直接调第三方，如千问/DeepSeek/OpenAI） ──
# 只要配了下面两个变量，且模型名不在 Coze 列表中，就会走自建 API
CUSTOM_LLM_API_KEY=sk-xxxxx
CUSTOM_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 常见的 BASE_URL：
#   千问:   https://dashscope.aliyuncs.com/compatible-mode/v1
#   DeepSeek: https://api.deepseek.com/v1
#   OpenAI:   https://api.openai.com/v1

# =============================================
# 运行时配置
# =============================================
DEPLOY_RUN_PORT=5000
COZE_PROJECT_ENV=DEV
